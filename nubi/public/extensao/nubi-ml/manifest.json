{
  "manifest_version": 3,
  "name": "nubi · Mercado Livre",
  "version": "0.3.0",
  "description": "A loja real de cada anúncio do Mercado Livre, o quadro nubi Spy (comissão, frete, visitas, vendas, concorrentes) e o painel com calculadora, histórico, tendências e gerador EAN.",
  "icons": {"128": "icone.png"},
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://*.mercadolivre.com.br/*", "https://api.mercadolibre.com/*", "https://nubi-explorador.vercel.app/*"],
  "background": {"service_worker": "fundo.js"},
  "content_scripts": [{
    "matches": ["https://*.mercadolivre.com.br/*"],
    "js": ["icones.js", "conteudo.js"],
    "css": ["estilo.css"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["painel.html", "painel.js", "painel.css", "icones.js"],
    "matches": ["https://*.mercadolivre.com.br/*"]
  }]
}
