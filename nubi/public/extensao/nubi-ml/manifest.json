{
  "manifest_version": 3,
  "name": "nubi · Mercado Livre",
  "version": "0.1.0",
  "description": "Mostra a loja real de cada anúncio do Mercado Livre (nome, cidade, reputação, vendas, data do anúncio) e liga ao nubi explorer.",
  "icons": {"128": "icone.png"},
  "host_permissions": ["https://*.mercadolivre.com.br/*", "https://api.mercadolibre.com/*"],
  "background": {"service_worker": "fundo.js"},
  "content_scripts": [{
    "matches": ["https://*.mercadolivre.com.br/*"],
    "js": ["conteudo.js"],
    "css": ["estilo.css"],
    "run_at": "document_idle"
  }]
}
